{
	"name": "subslate",
	"version": "2.0.0-beta.0",
	"description": "configurable template string replacement",
	"keywords": [
		"configurable",
		"custom",
		"expand",
		"format",
		"formatting",
		"interpolate",
		"interpolation",
		"light",
		"object",
		"parser",
		"parsing",
		"placeholders",
		"replace",
		"simple",
		"string",
		"template",
		"templating",
		"transform",
		"values"
	],
	"bugs": {
		"url": "https://github.com/josh-hemphill/subslate/issues"
	},
	"license": "MIT",
	"contributors": [
		{
			"name": "Joshua Hemphill",
			"url": "https://joshuahemphill.com",
			"email": "jhemphill@tecnicocorp.com"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/josh-hemphill/subslate.git"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"SECURITY.md"
	],
	"type": "module",
	"main": "./dist/subslate.esm.js",
	"module": "./dist/subslate.esm.js",
	"browser": "./dist/subslate.esm.js",
	"types": "./dist/subslate.d.ts",
	"unpkg": "./dist/subslate.js",
	"exports": {
		".": {
			"types": "./dist/subslate.d.ts",
			"default": "./dist/subslate.esm.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"prepack": "node scripts/build.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings src scripts test vitest.config.ts",
		"lint:markdown": "markdownlint-cli2 README.md",
		"spell": "cspell --no-progress README.md \"src/**/*.ts\"",
		"format": "oxfmt src scripts test .github/workflows README.md package.json jsr.json tsconfig.json vitest.config.ts",
		"format:check": "oxfmt --check src scripts test .github/workflows README.md package.json jsr.json tsconfig.json vitest.config.ts",
		"smoke": "node scripts/smoke.mjs",
		"stage:jsr": "node scripts/stage-jsr.mjs"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "5.1.1",
		"cspell": "10.3.0",
		"markdownlint-cli2": "0.23.2",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"playwright": "1.65.1",
		"rolldown": "1.3.3",
		"rolldown-plugin-dts": "0.30.2",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.1.1"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"packageManager": "pnpm@12.21.0"
}
